# Downloaded asset sources (tools/assets/fetch_polyhaven.py)
/.cache/

# Python bytecode (Blender tool scripts)
__pycache__/

# Door catalog extraction (tools/doors/catalog_index.py): catalogue photos, not ours to ship
/tools/doors/.cache/

# Window catalogue images beyond the ones in tools/windows/reference
/tools/windows/.cache/

# Case furniture: the manufacturer's assembly instructions (4–5 MB each; tools/casegoods/fetch_is.py downloads them),
# their cut lists and table pages are kept in tools/casegoods/reference/<collection>/
/tools/casegoods/.cache/
/tools/casegoods/reference/*/is/

# casegoods texture check sheets (regenerated by tools/casegoods/textures/<family>.py)
tools/casegoods/textures/sheets/

# lift texture check sheets (regenerated by tools/lifts/textures/<family>.py)
tools/lifts/textures/sheets/

# Medical catalogue (tools/medical): watcher renders and compare sheets, agents' scratch, catalogue photos
# (re-extract from Catalogs.zip; the screen crops used by textures/screens.py are kept)
/tools/medical/renders/
/tools/medical/scratch/
/tools/medical/reference/*
!/tools/medical/reference/*_screen.jpg
