{
  "name": "house-mcp",
  "version": "0.2.0",
  "description": "MCP server for the House app: lets any MCP-capable AI client design houses (walls, rooms, roofs, furniture) and see renders",
  "type": "module",
  "bin": {
    "house-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "embed": "node scripts/embed-guide.mjs",
    "build": "npm run embed && tsc -p tsconfig.json",
